{
  "esm": "1.3.0",
  "metadata": {
    "name": "van_der_pol_nonstiff",
    "description": "spec/toy-problems.md \u00a71.2, variant nonstiff: y' = z, z' = mu (1 - y^2) z - y, mu = 1."
  },
  "models": {
    "Oscillator": {
      "variables": {
        "y": {
          "type": "unknown",
          "default": 2
        },
        "z": {
          "type": "unknown",
          "default": 0
        },
        "mu": {
          "type": "parameter",
          "default": 1
        }
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["y"], "wrt": "t"},
          "rhs": "z"
        },
        {
          "lhs": {"op": "D", "args": ["z"], "wrt": "t"},
          "rhs": {"op": "-", "args": [{"op": "*", "args": ["mu", {"op": "-", "args": [1, {"op": "^", "args": ["y", 2]}]}, "z"]}, "y"]}
        }
      ]
    }
  },
  "solver": {
    "time_span": {
      "start": 0,
      "end": 6.3
    }
  }
}
