{
  "esm": "1.3.0",
  "metadata": {
    "name": "reseact_mini",
    "description": "spec/toy-problems.md \u00a75: reseact's shape at toy size (6 x 4 x 5 cells): NO2/NO/O3 chemistry with photolysis varying by longitude and level and a thermal rate from hourly two-record data, periodic upwind advection along lon and a column mean along lev. The M3 fixture for shards, lane pools and per-cell dt (spec/partitioning.md \u00a79)."
  },
  "domain": {
    "temporal": {
      "reference_time": "2016-01-01T00:00:00Z"
    }
  },
  "index_sets": {
    "lon": {
      "kind": "interval",
      "size": 6
    },
    "lat": {
      "kind": "interval",
      "size": 4
    },
    "lev": {
      "kind": "interval",
      "size": 5
    },
    "rec": {
      "kind": "interval",
      "size": 2,
      "records": true
    }
  },
  "data_sources": {
    "Met": {
      "kind": "grid",
      "source": {
        "url_template": "data/reseact_mini/met_{date:%Y%m%d}.nc"
      },
      "temporal": {
        "start": "2016-01-01T00:00:00Z",
        "frequency": "PT1H",
        "file_period": "P1D",
        "records_per_file": 24,
        "time_variable": "time"
      },
      "metadata": {
        "esio_format": "netcdf"
      }
    }
  },
