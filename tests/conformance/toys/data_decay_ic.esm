{
  "esm": "1.3.0",
  "metadata": {
    "name": "data_decay_ic",
    "description": "data_decay with an initial condition that reads data, ic(u[i]) = s[i] (spec/toy-problems.md §4.4, spec/operator-interface.md §8.4.5): a run starts from S_i, not the default 1.0."
  },
  "domain": {
    "temporal": {
      "reference_time": "2016-01-01T00:00:00Z"
    }
  },
  "index_sets": {
    "x": {
      "kind": "interval",
      "size": 3
    },
    "rec": {
      "kind": "interval",
      "size": 2,
      "records": true
    }
  },
  "data_sources": {
    "Rate": {
      "kind": "grid",
      "source": {
        "url_template": "data/data_decay/rate_{date:%Y%m%d}.nc"
      },
      "temporal": {
        "start": "2016-01-01T00:00:00Z",
        "frequency": "PT1H",
        "file_period": "P1D",
        "records_per_file": 24,
        "time_variable": "time"
      },
      "metadata": {
        "esio_format": "netcdf"
      }
    },
    "Scale": {
      "kind": "static",
      "source": {
        "url_template": "data/data_decay/scale.nc"
      },
      "metadata": {
        "esio_format": "netcdf"
      }
    }
  },
  "models": {
    "Decay": {
      "variables": {
        "u": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "x"
          ],
          "default": 1.0
        },
        "F_k": {
          "type": "parameter",
          "units": "1/s",
          "shape": [
            "rec",
            "x"
          ],
          "default": 0.0001,
          "update": {
            "kind": "data",
            "source": "Rate",
            "from": {
              "file_variable": "K"
            }
          }
        },
        "s": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "x"
          ],
          "default": 1.0,
          "update": {
            "kind": "data",
            "source": "Scale",
            "from": {
              "file_variable": "S"
            }
          }
        },
        "dtrec": {
          "type": "parameter",
          "units": "s",
          "default": 3600.0
        },
        "w": {
          "type": "unknown",
          "units": "1"
        }
      },
      "equations": [
        {
          "lhs": "w",
          "rhs": {
            "op": "-",
            "args": [
              {
                "op": "/",
                "args": [
                  "t",
                  "Decay.dtrec"
                ]
              },
              {
                "op": "floor",
                "args": [
                  {
                    "op": "/",
                    "args": [
                      "t",
                      "Decay.dtrec"
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "makearray",
            "args": [],
            "regions": [
              [
                [
                  1,
                  3
                ]
              ]
            ],
            "values": [
              {
                "op": "faq",
                "args": [],
                "output_idx": [
                  "i"
                ],
                "ranges": {
                  "i": [
                    1,
                    3
                  ]
                },
                "expr": {
                  "op": "-",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "Decay.s",
                            "i"
                          ]
                        },
                        {
                          "op": "+",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "Decay.F_k",
                                1,
                                "i"
                              ]
                            },
                            {
                              "op": "*",
                              "args": [
                                "Decay.w",
                                {
                                  "op": "-",
                                  "args": [
                                    {
                                      "op": "index",
                                      "args": [
                                        "Decay.F_k",
                                        2,
                                        "i"
                                      ]
                                    },
                                    {
                                      "op": "index",
                                      "args": [
                                        "Decay.F_k",
                                        1,
                                        "i"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "op": "index",
                          "args": [
                            "Decay.u",
                            "i"
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "u"
            ]
          },
          "rhs": "Decay.s"
        }
      ]
    }
  }
}
