{
  "esm": "1.3.0",
  "metadata": {
    "name": "robertson",
    "description": "spec/toy-problems.md \u00a71.3: Robertson's stiff kinetics."
  },
  "models": {
    "Kinetics": {
      "variables": {
        "y1": {
          "type": "unknown",
          "default": 1
        },
        "y2": {
          "type": "unknown",
          "default": 0
        },
        "y3": {
          "type": "unknown",
          "default": 0
        },
        "k1": {
          "type": "parameter",
          "default": 0.04
        },
        "k2": {
          "type": "parameter",
          "default": 30000000
        },
        "k3": {
          "type": "parameter",
          "default": 10000
        }
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["y1"], "wrt": "t"},
          "rhs": {"op": "+", "args": [{"op": "*", "args": [-1, "k1", "y1"]}, {"op": "*", "args": ["k3", "y2", "y3"]}]}
        },
        {
          "lhs": {"op": "D", "args": ["y2"], "wrt": "t"},
          "rhs": {"op": "-", "args": [{"op": "-", "args": [{"op": "*", "args": ["k1", "y1"]}, {"op": "*", "args": ["k3", "y2", "y3"]}]}, {"op": "*", "args": ["k2", {"op": "^", "args": ["y2", 2]}]}]}
        },
        {
          "lhs": {"op": "D", "args": ["y3"], "wrt": "t"},
          "rhs": {"op": "*", "args": ["k2", {"op": "^", "args": ["y2", 2]}]}
        }
      ]
    }
  },
  "solver": {
    "stiffness": "high",
    "time_span": {
      "start": 0,
      "end": 40
    }
  }
}
