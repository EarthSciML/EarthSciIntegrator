{
  "esm": "1.3.0",
  "metadata": {
    "name": "forced_decay",
    "description": "spec/toy-problems.md \u00a71.1: u' = -k u + sin(omega t), u(0) = 1."
  },
  "models": {
    "Decay": {
      "variables": {
        "u": {
          "type": "unknown",
          "default": 1
        },
        "k": {
          "type": "parameter",
          "default": 2
        },
        "omega": {
          "type": "parameter",
          "default": 3
        }
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["u"], "wrt": "t"},
          "rhs": {"op": "+", "args": [{"op": "*", "args": [-1, "k", "u"]}, {"op": "sin", "args": [{"op": "*", "args": ["omega", "t"]}]}]}
        }
      ]
    }
  },
  "solver": {
    "time_span": {
      "start": 0,
      "end": 2
    }
  }
}
