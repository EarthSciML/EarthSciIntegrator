{
  "esm_integrator": "0.1.0",
  "description": "spec/toy-problems.md §1.7 with the scalar factor a on c, and an adjoint (D127): the parameter product of the residual.",
  "model": "model.esm",
  "operators": {
    "cubic": {
      "select": {
        "components": "Cubic"
      }
    }
  },
  "step": {
    "dt": 1
  },
  "schedule": {
    "solve": "cubic",
    "unknowns": [
      "Cubic.z"
    ],
    "method": {
      "newton": {},
      "linesearch": "backtracking",
      "converged": {
        "residual": 1e-12
      },
      "maxiter": 50
    }
  },
  "adjoint": {
    "functional": {
      "sum": "Cubic.z",
      "over": "final"
    },
    "wrt": [
      "u0",
      "params:numeric"
    ]
  }
}
