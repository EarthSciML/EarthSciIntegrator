{
  "esm_integrator": "0.1.0",
  "model": "model.esm",
  "operators": {
    "box": {
      "select": {
        "components": "Box"
      }
    }
  },
  "step": {
    "dt": 1
  },
  "description": "ptc with a tiny first step limited to two iterations, which fails, then a recover step to newton with backtracking, scale 2 (D125).",
  "schedule": {
    "solve": "box",
    "unknowns": [
      "Box.z"
    ],
    "method": {
      "ptc": {
        "dt0": 1e-06
      },
      "scale": {
        "Box.z": 2.0
      },
      "converged": {
        "residual": 1e-12
      },
      "maxiter": 2,
      "recover": [
        {
          "method": {
            "newton": {},
            "linesearch": "backtracking",
            "maxiter": 50
          }
        }
      ]
    }
  }
}
