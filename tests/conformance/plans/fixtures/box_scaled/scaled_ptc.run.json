{
  "esm_integrator": "0.1.0",
  "model": "model.esm",
  "operators": {
    "box": {
      "select": {
        "components": "Box"
      }
    }
  },
  "step": {
    "dt": 1
  },
  "description": "ptc with uncapped growth on the residual scaled by the state-free observed zscale (D125).",
  "schedule": {
    "solve": "box",
    "unknowns": [
      "Box.z"
    ],
    "method": {
      "ptc": {
        "dt0": 1,
        "growth": "uncapped"
      },
      "scale": {
        "Box.z": "Box.zscale"
      },
      "converged": {
        "residual": 1e-12
      },
      "maxiter": 500
    }
  }
}
