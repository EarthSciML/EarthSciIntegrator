                    "b",
                    "i"
                  ]
                },
                {
                  "op": "faq",
                  "output_idx": [],
                  "args": [],
                  "ranges": {
                    "j": {
                      "from": "k"
                    }
                  },
                  "expr": {
                    "op": "*",
