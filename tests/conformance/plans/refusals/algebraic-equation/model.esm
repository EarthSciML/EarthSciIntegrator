{
  "esm": "1.3.0",
  "metadata": {
    "name": "algebraic"
  },
  "models": {
    "Box": {
      "variables": {
        "x": {
          "type": "unknown",
          "default": 0.5
        },
        "y": {
          "type": "unknown",
          "default": 0.5
        }
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["x"], "wrt": "t"},
          "rhs": {"op": "*", "args": [-1, "y"]}
        },
        {
          "lhs": {"op": "+", "args": ["x", "y"]},
          "rhs": 1
        }
      ]
    }
  },
  "solver": {
    "time_span": {
      "start": 0,
      "end": 1
    }
  }
}
