{
  "esm": "1.3.0",
  "metadata": {
    "name": "mixed_shapes",
    "description": "A scalar state and an array state, each decaying in place: one pointwise operator whose states are neither all scalars nor arrays of one shape."
  },
  "index_sets": {
    "cell": {"kind": "interval", "size": 4}
  },
  "models": {
    "Box": {
      "variables": {
        "s": {"type": "unknown", "default": 1},
        "a": {"type": "unknown", "shape": ["cell"], "default": 1},
        "k": {"type": "parameter", "default": 1000}
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["s"], "wrt": "t"},
          "rhs": {"op": "*", "args": [-1, "k", "s"]}
        },
        {
          "lhs": {"op": "D", "args": ["a"], "wrt": "t"},
          "rhs": {"op": "faq", "args": [], "output_idx": ["i"], "ranges": {"i": {"from": "cell"}}, "expr": {"op": "*", "args": [-1, "k", {"op": "index", "args": ["a", "i"]}]}}
        }
      ]
    }
  },
  "solver": {
    "stiffness": "high",
    "time_span": {"start": 0, "end": 1}
  }
}
