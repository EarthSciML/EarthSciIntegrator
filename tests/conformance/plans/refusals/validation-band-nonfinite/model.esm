{
  "esm": "2.1.0",
  "metadata": {
    "name": "sqrt_rate",
    "description": "D(x) = -sqrt(c x) with c = 0: the right-hand side is 0 at every state, its derivative -c/(2 sqrt(c x)) is 0/0, NaN, so the band check refuses (spec/plan.md \u00a78.1): a non-finite band value fails it whatever the independent Jacobian says."
  },
  "models": {
    "Root": {
      "variables": {
        "x": {
          "type": "unknown",
          "default": 1.0
        },
        "c": {
          "type": "parameter",
          "default": 0.0
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "-",
            "args": [
              {
                "op": "sqrt",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      "c",
                      "x"
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "solver": {
    "time_span": {
      "start": 0,
      "end": 1
    }
  }
}
