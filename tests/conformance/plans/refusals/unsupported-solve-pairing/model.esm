{
  "esm": "2.1.0",
  "metadata": {
    "name": "reversed",
    "description": "Each residual element reads the unknown in the mirrored cell, index 5 - i: no diagonal pairing, though one exists element by element (spec/plan.md \u00a75.9.5)."
  },
  "index_sets": {
    "cell": {
      "kind": "interval",
      "size": 4
    }
  },
  "models": {
    "Cubic": {
      "variables": {
        "z": {
          "type": "unknown",
          "shape": [
            "cell"
          ],
          "default": 0.0,
          "description": "the root in each cell (algebraic unknown)"
        },
        "c": {
          "type": "parameter",
          "shape": [
            "cell"
          ],
          "default": [
            1.0,
            2.0,
            3.0,
            4.0
          ]
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "faq",
            "output_idx": [
              "i"
            ],
            "args": [],
            "ranges": {
              "i": {
                "from": "cell"
              }
            },
            "expr": {
              "op": "-",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "z",
                    {
                      "op": "-",
                      "args": [
                        5,
                        "i"
                      ]
                    }
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "c",
                    "i"
                  ]
                }
              ]
            }
          },
          "rhs": 0.0
        }
      ]
    }
  },
  "solver": {
    "time_span": {
      "start": 0,
      "end": 1
    }
  }
}
