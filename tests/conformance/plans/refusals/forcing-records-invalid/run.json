{
  "esm_integrator": "0.1.0",
  "description": "forced_column's named case on a model whose two-record data-fed parameter Met.T reads a source that is not time-varying: forcing_records_invalid at /model.",
  "model": "model.esm",
  "axes": {
    "horizontal": [
      "x"
    ],
    "vertical": "lev"
  },
  "step": {
    "dt": 3600,
    "hit": [
      "forcing_refresh"
    ]
  },
  "schedule": {
    "sequence": [
      {
        "leaf": "default_column",
        "alg": "TRBDF2",
        "dt": 600
      },
      {
        "leaf": "default_pointwise"
      }
    ]
  }
}
