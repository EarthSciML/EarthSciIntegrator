          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/qualifiedName"}
        }
      }
    },
    "restart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "every": {"$ref": "#/$defs/duration"},
        "from": {"type": "string", "minLength": 1}
      }
    }
  }
